<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>14</LangVersion>

        <!--
        Chunk generation runs one pool task per chunk and each one allocates megabytes, which
        workstation GC collects on the allocating thread and therefore inside a chunk load. This is
        an application's choice rather than a library's, so it is set here and recommended in the
        readme rather than being put in ManagedServer.csproj.
        -->
        <ServerGarbageCollection>true</ServerGarbageCollection>
        <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\ManagedServer\ManagedServer.csproj" />
      <ProjectReference Include="..\Minecraft\Minecraft.csproj" />
      <ProjectReference Include="..\PolarWorlds\PolarWorlds.csproj" />
    </ItemGroup>

    <ItemGroup>
      <None Update="Servers\SkyWarsLuckyBlock\Maps\lobby.polar">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="Servers\SkyWarsLuckyBlock\Maps\ramen.polar">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
    </ItemGroup>

</Project>
